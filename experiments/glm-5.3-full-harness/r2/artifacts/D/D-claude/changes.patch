+def test_cleanup_functions_executed_on_failure(testdir):
+    """
+    Cleanups registered with `TestCase.addCleanup` must also be executed when
+    the test fails: pytest interrupts `unittest.TestCase.run` (raising
+    `_GetOutOf_testPartExecutor`) to report the failure itself, which used to
+    skip the `doCleanups` call at the end of `TestCase.run`, leaking resources
+    registered via `addCleanup`.
+    """
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+
+        cleanups = []
+
+        class MyTestCase(unittest.TestCase):
+            def test_1_pass(self):
+                self.addCleanup(cleanups.append, "pass")
+
+            def test_2_fail(self):
+                self.addCleanup(cleanups.append, "fail")
+                assert False, 'intentional'
+
+            def test_3_check(self):
+                self.assertEqual(cleanups, ["pass", "fail"])
+    """
+    )
+    reprec = testdir.inline_run(testpath)
+    reprec.assertoutcome(passed=2, failed=1)
 
 
