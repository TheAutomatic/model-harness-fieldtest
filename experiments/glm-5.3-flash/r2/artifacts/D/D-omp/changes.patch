@@ -192,6 +193,11 @@
     def addSuccess(self, testcase):
         pass
 
+    # Adapted from CPython's unittest.TestResult.addDuration: since we
+    # instrument durations ourselves, it is a no-op (Python 3.12+ calls it).
+    def addDuration(self, testcase, elapsed):
+        pass
+
     def stopTest(self, testcase):
         pass
 
@@ -236,7 +242,15 @@
             try:
                 self._testcase(result=self)
             except _GetOutOf_testPartExecutor as exc:
