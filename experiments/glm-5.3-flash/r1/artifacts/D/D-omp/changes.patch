+def test_testcase_do_cleanups_when_test_fails(testdir):
+    # PYTEST_DONT_REWRITE: this checkout's assertion rewriter is incompatible
+    # with this Python's AST, which breaks collection of inner test modules.
+    testpath = testdir.makepyfile(
+        '''
+        """PYTEST_DONT_REWRITE"""
+        import unittest
+
+        cleanups = []
+
+        class TestExample(unittest.TestCase):
+            def test_1_pass(self):
+                self.addCleanup(cleanups.append, "passed")
+
+            def test_2_fail(self):
+                self.addCleanup(cleanups.append, "failed")
+                assert False
+
+            def test_3_check(self):
+                assert cleanups == ["passed", "failed"]
+        '''
+    )
+    reprec = testdir.inline_run(testpath)
+    reprec.assertoutcome(passed=2, failed=1)
+
+
+def test_testcase_cleanup_error_is_reported(testdir):
+    testpath = testdir.makepyfile(
+        '''
+        """PYTEST_DONT_REWRITE"""
+        import unittest
+
+        class TestExample(unittest.TestCase):
+            def test_1_fail_with_broken_cleanup(self):
+                self.addCleanup(lambda: 0 / 0)
+                assert False
+        '''
+    )
+    result = testdir.runpytest()
+    result.stdout.fnmatch_lines(
+        [
+            "*ERROR at teardown of*",
+            "*ZeroDivisionError*",
+            "*1 failed*1 error*",
+        ]
+    )
+
