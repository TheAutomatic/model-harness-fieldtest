+def test_cleanups_and_teardown_run_when_test_fails(testdir):
+    """
+    Cleanups registered with addCleanup() and tearDown() must run even when
+    the test method fails: the failure escapes unittest's testPartExecutor
+    so pytest can handle it (notably --pdb), so the plugin must run the
+    remaining parts of TestCase.run() itself (#issue10661-like regression).
+    """
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+        class MyTestCase(unittest.TestCase):
+            values = []
+            def tearDown(self):
+                self.values.append("teardown")
+            def test_one_fail(self):
+                self.addCleanup(self.values.append, "cleanup1")
+                self.addCleanup(self.values.append, "cleanup2")
+                assert False, "intentional failure"
+            def test_two_check(self):
+                self.assertEqual(
+                    MyTestCase.values, ["teardown", "cleanup2", "cleanup1"]
+                )
+    """
+    )
+    reprec = testdir.inline_run(testpath)
+    passed, skipped, failed = reprec.countoutcomes()
+    assert failed == 1, failed
+    assert passed == 1
+    assert passed + skipped + failed == 2
 
 
