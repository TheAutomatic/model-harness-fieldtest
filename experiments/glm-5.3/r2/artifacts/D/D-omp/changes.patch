@@ -1146,3 +1146,45 @@
     testdir.copy_example("unittest/test_unittest_asynctest.py")
     reprec = testdir.inline_run()
     reprec.assertoutcome(failed=1, passed=2)
+
+
+def test_cleanup_functions_called_on_failure(testdir):
+    """addCleanup() functions must run even when the test method fails."""
+    testdir.makepyfile(
+        """
+        import unittest
+
+        cleanups = []
+
+        class MyTestCase(unittest.TestCase):
+            def test_a_fail(self):
+                self.addCleanup(cleanups.append, "failed")
+                assert False, "intentional"
+
+            def test_z_check(self):
+                assert cleanups == ["failed"]
+        """
+    )
+    result = testdir.runpytest("--assert=plain")
+    result.assert_outcomes(passed=1, failed=1)
+
+
+def test_cleanup_functions_called_on_skip(testdir):
+    """addCleanup() functions must also run when the test method skips."""
+    testdir.makepyfile(
+        """
+        import unittest
+
+        cleanups = []
+
+        class MyTestCase(unittest.TestCase):
+            def test_a_skip(self):
+                self.addCleanup(cleanups.append, "skipped")
+                self.skipTest("skipping")
+
+            def test_z_check(self):
+                assert cleanups == ["skipped"]
+        """
+    )
+    result = testdir.runpytest("--assert=plain")
+    result.assert_outcomes(passed=1, skipped=1)
