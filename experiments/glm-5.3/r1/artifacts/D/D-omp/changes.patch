--- a/changelog/7144.bugfix.rst
+++ b/changelog/7144.bugfix.rst
@@ -0,0 +1,3 @@
+``unittest.TestCase`` tests now execute cleanups registered with ``addCleanup``
+when the test method fails, matching the behavior of the standard ``unittest``
+runner.
--- a/changelog/7145.bugfix.rst
+++ b/changelog/7145.bugfix.rst
@@ -0,0 +1,3 @@
+Implement the optional ``TestResult.addDuration`` method for ``unittest``-style
+tests, avoiding a ``RuntimeWarning`` on Python 3.12+ which could turn into an
+error under ``filterwarnings = error``.
--- a/testing/test_unittest.py
+++ b/testing/test_unittest.py
@@ -1146,3 +1146,26 @@
     testdir.copy_example("unittest/test_unittest_asynctest.py")
     reprec = testdir.inline_run()
     reprec.assertoutcome(failed=1, passed=2)
+
+
+def test_add_cleanup_is_executed_for_failing_test(testdir):
+    """Cleanups registered with ``addCleanup`` must be executed when the test
+    method fails: pytest leaves ``TestCase.run`` via an internal exception in
+    that case, skipping unittest's own ``doCleanups`` call."""
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+
+        cleanups = []
+
+        class MyTestCase(unittest.TestCase):
+            def test_1_fail(self):
+                self.addCleanup(cleanups.append, "failed")
+                assert False, "intentional failure"
+
+            def test_2_check(self):
+                assert cleanups == ["failed"]
+    """
+    )
+    reprec = testdir.inline_run(testpath, "--assert=plain")
+    reprec.assertoutcome(failed=1, passed=1)
