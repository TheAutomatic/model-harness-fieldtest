+def test_unittest_addcleanup_called_on_failure(testdir):
+    """Cleanups registered with addCleanup must run even if the test fails."""
+    testdir.makepyfile(
+        """
+        import unittest
+
+        cleanups = []
+
+        class MyTestCase(unittest.TestCase):
+            def test_a_pass(self):
+                self.addCleanup(cleanups.append, "pass")
+
+            def test_b_fail(self):
+                self.addCleanup(cleanups.append, "fail")
+                assert False
+
+            def test_c_check_cleanups(self):
+                assert cleanups == ["pass", "fail"]
+        """
+    )
+    reprec = testdir.inline_run()
+    reprec.assertoutcome(failed=1, passed=2)
+
+
