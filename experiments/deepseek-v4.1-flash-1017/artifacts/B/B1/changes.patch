+
+    def test_HTTP_303_THEN_307_KEEPS_GET(self):
+        """A 307 after a 303 must not restore the method the 303 replaced."""
+        seen = []
+        statuses = [303, 307, 200]
+
+        class Handler(BaseHTTPRequestHandler):
+            def handle_request(self):
+                seen.append(self.command)
+                idx = len(seen) - 1
+                self.send_response(statuses[idx])
+                if idx + 1 < len(statuses):
+                    self.send_header('Location', '/next')
+                self.send_header('Content-Length', '0')
+                self.end_headers()
+
+            do_GET = do_POST = handle_request
+
+            def log_message(self, *args):
+                pass
+
+        server = HTTPServer(('127.0.0.1', 0), Handler)
+        thread = threading.Thread(target=server.serve_forever)
+        thread.daemon = True
+        thread.start()
+        try:
+            s = requests.session()
+            s.trust_env = False
+            s.post('http://127.0.0.1:%s/' % server.server_port,
+                   data='hello', timeout=3)
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join()
+
+        assert seen == ['POST', 'GET', 'GET']
 
