+class _MockRaw(object):
+    def release_conn(self):
+        pass
+
+
+class _RedirectAdapter(BaseAdapter):
+    def __init__(self, responses):
+        super(_RedirectAdapter, self).__init__()
+        self._responses = list(responses)
+        self.requests = []
+
+    def send(self, request, **kwargs):
+        self.requests.append((
+            request.method,
+            request.url,
+            request.body,
+            CaseInsensitiveDict(request.headers),
+        ))
+        status_code, location = self._responses.pop(0)
+        resp = requests.Response()
+        resp.status_code = status_code
+        resp.url = request.url
+        resp.request = request
+        resp.raw = _MockRaw()
+        resp._content = b''
+        resp._content_consumed = True
+        if location is not None:
+            resp.headers['Location'] = location
+        return resp
+
+    def close(self):
+        pass
+
+
+class TestRedirects(unittest.TestCase):
+    def _run_chain(self, method, url, hops, **kwargs):
+        adapter = _RedirectAdapter(hops)
+        session = requests.Session()
+        session.trust_env = False
+        session.mount('http://example.com', adapter)
+        session.mount('http://other.com', adapter)
+        try:
+            resp = session.request(method, url, **kwargs)
+        finally:
+            session.close()
+        return resp, adapter.requests
+
+    def test_post_303_then_307_keeps_get(self):
+        resp, sent = self._run_chain(
+            'POST',
+            'http://example.com/start',
+            [(303, '/second'), (307, '/done'), (200, None)],
+            data='hello',
+        )
+        assert [s[0] for s in sent] == ['POST', 'GET', 'GET']
+        assert sent[0][2] == 'hello'
+        assert sent[1][2] is None
+        assert sent[2][2] is None
+        assert 'Content-Length' not in sent[1][3]
+        assert 'Content-Length' not in sent[2][3]
+        assert [h.request.method for h in resp.history] + [resp.request.method] == ['POST', 'GET', 'GET']
+
+    def test_post_302_and_301_then_307_keep_get(self):
+        for code in (301, 302):
+            resp, sent = self._run_chain(
+                'POST',
+                'http://example.com/start',
+                [(code, '/second'), (307, '/done'), (200, None)],
+                data='hello',
+            )
+            assert [s[0] for s in sent] == ['POST', 'GET', 'GET']
+            assert sent[1][2] is None and sent[2][2] is None
+            assert 'Content-Length' not in sent[1][3]
+            assert 'Content-Length' not in sent[2][3]
+
+    def test_post_307_preserves_method_and_body(self):
+        resp, sent = self._run_chain(
+            'POST',
+            'http://example.com/start',
+            [(307, '/second'), (307, '/done'), (200, None)],
+            data='hello',
+        )
+        assert [s[0] for s in sent] == ['POST', 'POST', 'POST']
+        assert [s[2] for s in sent] == ['hello', 'hello', 'hello']
+        assert [s[3]['Content-Length'] for s in sent] == ['5', '5', '5']
+
+    def test_post_307_then_303_then_307(self):
+        resp, sent = self._run_chain(
+            'POST',
+            'http://example.com/start',
+            [(307, '/hop1'), (303, '/hop2'), (307, '/done'), (200, None)],
+            data='hello',
+        )
+        assert [s[0] for s in sent] == ['POST', 'POST', 'GET', 'GET']
+        assert sent[0][2] == 'hello' and sent[1][2] == 'hello'
+        assert sent[2][2] is None and sent[3][2] is None
+        assert 'Content-Length' not in sent[2][3]
+        assert 'Content-Length' not in sent[3][3]
+
+    def test_head_and_put_multi_hop_redirects(self):
+        _, sent_head = self._run_chain(
+            'HEAD',
+            'http://example.com/start',
+            [(303, '/second'), (307, '/done'), (200, None)],
+        )
+        assert [s[0] for s in sent_head] == ['HEAD', 'HEAD', 'HEAD']
+
+        _, sent_put = self._run_chain(
+            'PUT',
+            'http://example.com/start',
+            [(301, '/second'), (307, '/done'), (200, None)],
+            data='hello',
+        )
+        assert [s[0] for s in sent_put] == ['PUT', 'PUT', 'PUT']
+        assert sent_put[1][2] is None and sent_put[2][2] is None
+        assert 'Content-Length' not in sent_put[1][3]
+        assert 'Content-Length' not in sent_put[2][3]
+
+    def test_cross_host_auth_not_reapplied_on_subsequent_redirect(self):
+        _, sent = self._run_chain(
+            'GET',
+            'http://example.com/start',
+            [(302, 'http://other.com/hop1'), (307, 'http://other.com/hop2'), (200, None)],
+            auth=('user', 'pass'),
+        )
+        assert [s[0] for s in sent] == ['GET', 'GET', 'GET']
+        assert 'Authorization' in sent[0][3]
+        assert 'Authorization' not in sent[1][3]
+        assert 'Authorization' not in sent[2][3]
+
