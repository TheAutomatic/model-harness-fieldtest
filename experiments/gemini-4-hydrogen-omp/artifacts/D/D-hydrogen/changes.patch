+def test_addcleanup_on_failure(testdir):
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+
+        events = []
+
+        class MyTestCase(unittest.TestCase):
+            def setUp(self):
+                self.addCleanup(events.append, ("setup_cleanup", self._testMethodName))
+
+            def tearDown(self):
+                events.append(("tearDown", self._testMethodName))
+
+            def test_1_pass(self):
+                self.addCleanup(events.append, ("test_cleanup", self._testMethodName))
+
+            def test_2_fail(self):
+                self.addCleanup(events.append, ("test_cleanup_1", self._testMethodName))
+                self.addCleanup(events.append, ("test_cleanup_2", self._testMethodName))
+                assert False, "intentional"
+
+            def test_3_verify(self):
+                assert events == [
+                    ("tearDown", "test_1_pass"),
+                    ("test_cleanup", "test_1_pass"),
+                    ("setup_cleanup", "test_1_pass"),
+                    ("tearDown", "test_2_fail"),
+                    ("test_cleanup_2", "test_2_fail"),
+                    ("test_cleanup_1", "test_2_fail"),
+                    ("setup_cleanup", "test_2_fail"),
+                ]
+        """
+    )
+    reprec = testdir.inline_run("--assert=plain", testpath)
+    reprec.assertoutcome(passed=2, failed=1)
+
+
+def test_addcleanup_runs_when_teardown_or_cleanup_fails(testdir):
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+
+        events = []
+
+        class TestTearDownError(unittest.TestCase):
+            def tearDown(self):
+                events.append("tearDown")
+                raise RuntimeError("teardown boom")
+
+            def test_fail(self):
+                self.addCleanup(events.append, "cleanup_after_teardown_error")
+                assert False, "test boom"
+
+        class TestCleanupError(unittest.TestCase):
+            def test_fail(self):
+                def bad():
+                    events.append("bad_cleanup")
+                    raise RuntimeError("cleanup boom")
+                self.addCleanup(events.append, "cleanup_after_bad")
+                self.addCleanup(bad)
+                assert False, "test boom 2"
+
+        def test_verify():
+            assert events == [
+                "tearDown",
+                "cleanup_after_teardown_error",
+                "bad_cleanup",
+                "cleanup_after_bad",
+            ]
+        """
+    )
+    result = testdir.runpytest("--assert=plain", testpath)
+    result.stdout.fnmatch_lines(
+        [
+            "*RuntimeError: teardown boom*",
+            "*RuntimeError: cleanup boom*",
+            "*2 failed, 1 passed, 2 errors*",
+        ]
+    )
