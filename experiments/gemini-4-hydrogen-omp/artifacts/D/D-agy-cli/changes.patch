+def test_cleanup_on_failure(testdir):
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+
+        events = []
+
+        class TC(unittest.TestCase):
+            def setUp(self):
+                self.addCleanup(events.append, "setup_1")
+                self.addCleanup(events.append, "setup_2")
+
+            def tearDown(self):
+                events.append("tearDown")
+                self.addCleanup(events.append, "teardown_cleanup")
+
+            def test_pass(self):
+                self.addCleanup(events.append, "pass_cleanup")
+
+            def test_fail(self):
+                self.addCleanup(events.append, "fail_cleanup_1")
+                self.addCleanup(events.append, "fail_cleanup_2")
+                assert False, "intentional"
+
+        class TCWithFailingTearDown(unittest.TestCase):
+            def tearDown(self):
+                events.append("failing_tearDown")
+                raise RuntimeError("td error")
+
+            def test_fail_both(self):
+                self.addCleanup(events.append, "after_failing_td")
+                assert False, "intentional"
+
+        def test_verify():
+            assert events == [
+                "tearDown",
+                "teardown_cleanup",
+                "fail_cleanup_2",
+                "fail_cleanup_1",
+                "setup_2",
+                "setup_1",
+                "tearDown",
+                "teardown_cleanup",
+                "pass_cleanup",
+                "setup_2",
+                "setup_1",
+                "failing_tearDown",
+                "after_failing_td",
+            ]
+        """
+    )
+    reprec = testdir.inline_run(testpath)
+    passed, skipped, failed = reprec.countoutcomes()
+    assert passed == 2
+    assert skipped == 0
+    # test_fail (call), test_fail_both (call + teardown error)
+    assert failed == 3
+
+
+def test_cleanup_failure_on_failing_test(testdir):
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+
+        cleanups = []
+
+        class TC(unittest.TestCase):
+            def test_fail_and_bad_cleanup(self):
+                self.addCleanup(cleanups.append, "first")
+                self.addCleanup(lambda: 1 / 0)
+                self.addCleanup(cleanups.append, "last")
+                assert False, "test failure"
+
+        def test_verify_remaining_cleanups():
+            assert cleanups == ["last", "first"]
+        """
+    )
+    result = testdir.runpytest(testpath)
+    assert result.ret == 1
+    result.stdout.fnmatch_lines(
+        [
+            "*ERROR at teardown of TC.test_fail_and_bad_cleanup*",
+            "*ZeroDivisionError*",
+            "*1 failed, 1 passed, 1 error*",
+        ]
+    )
+
+
+def test_cleanup_with_skip(testdir):
+    testpath = testdir.makepyfile(
+        """
+        import pytest
+        import unittest
+
+        events = []
+
+        class TC(unittest.TestCase):
+            def tearDown(self):
+                events.append("tearDown")
+
+            @unittest.skip("decorator skip")
+            def test_1_decorator_skip(self):
+                self.addCleanup(events.append, "should_not_run")
+
+            def test_2_skipTest(self):
+                self.addCleanup(events.append, "skipTest_cleanup")
+                self.skipTest("imperative unittest skip")
+
+            def test_3_pytest_skip(self):
+                self.addCleanup(events.append, "pytest_skip_cleanup")
+                pytest.skip("imperative pytest skip")
+
+        class TCSkipInSetUp(unittest.TestCase):
+            def setUp(self):
+                self.addCleanup(events.append, "setup_skip_cleanup")
+                self.skipTest("skip in setUp")
+
+            def tearDown(self):
+                events.append("should_not_run_tearDown")
+
+            def test_4_never_runs(self):
+                events.append("should_not_run_test")
+
+        def test_5_verify():
+            assert events == [
+                "tearDown",
+                "skipTest_cleanup",
+                "tearDown",
+                "pytest_skip_cleanup",
+                "setup_skip_cleanup",
+            ]
+        """
+    )
+    reprec = testdir.inline_run(testpath)
+    reprec.assertoutcome(passed=1, skipped=4)
+
+
+def test_cleanup_runs_after_exception_interact(testdir):
+    testdir.makeconftest(
+        """
+        seen_during_interact = []
+
+        def pytest_exception_interact(node, call, report):
+            seen_during_interact.append((call.when, list(node.module.events)))
+        """
+    )
+    testpath = testdir.makepyfile(
+        """
+        import unittest
+
+        events = []
+
+        class TC(unittest.TestCase):
+            def tearDown(self):
+                events.append("tearDown")
+
+            def test_1_fail(self):
+                self.addCleanup(events.append, "cleanup")
+                assert False, "intentional"
+
+            def test_2_verify(self):
+                import conftest
+                assert conftest.seen_during_interact == [("call", [])]
+                assert events == ["tearDown", "cleanup"]
+        """
+    )
+    reprec = testdir.inline_run(testpath)
+    reprec.assertoutcome(passed=1, failed=1)
